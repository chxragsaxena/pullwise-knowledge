# Copy to .env (git-ignored). Used by docker-compose.yml and the service.

POSTGRES_PASSWORD=change-me

# Cohere trial key (free): dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Token secret, 32+ bytes, shared with PullWise: openssl rand -base64 32
JWT_SECRET=

# Optional HTTPS and mutual TLS; dev certs: go run ./cmd/devcerts -out certs
# TLS_CERT_FILE=certs/server.pem
# TLS_KEY_FILE=certs/server-key.pem
# TLS_CLIENT_CA_FILE=certs/ca.pem
